#!/bin/sh
set -eu
cd -- "$(dirname -- "$0")/../.."

go test ./internal/engine/readiness/... ./internal/engine/session/...

if ! out=$(go test -v -run '^TestCredentialRawContract(RejectsFaultyFakes)?$' \
    ./internal/engine/readiness/port/porttest ./internal/engine/readiness/disk); then
    printf '%s\n' "$out" >&2
    exit 1
fi
printf '%s\n' "$out"

if [ "$(printf '%s\n' "$out" | grep -c '^--- PASS[:] TestCredentialRawContract [(]')" != 2 ]; then
    echo 'Expected two passing raw contract runs, one per implementation.' >&2
    exit 1
fi
if ! printf '%s\n' "$out" | grep -q '^--- PASS[:] TestCredentialRawContractRejectsFaultyFakes [(]'; then
    echo 'Expected the faulty-fake negative control to pass.' >&2
    exit 1
fi
