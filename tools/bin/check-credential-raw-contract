#!/bin/sh
set -eu
cd -- "$(dirname -- "$0")/../.."

check_raw_contract() {
    package=$1
    shift
    if ! out=$(go test -v -run '^TestCredentialRawContract(RejectsFaultyFakes)?$' "$package"); then
        printf '%s\n' "$out" >&2
        return 1
    fi
    printf '%s\n' "$out"

    for test_name do
        if ! printf '%s\n' "$out" | grep -qF -- "--- PASS: $test_name ("; then
            printf 'Expected %s to pass in %s.\n' "$test_name" "$package" >&2
            return 1
        fi
    done
}

check_raw_contract ./internal/engine/readiness/port/porttest \
    TestCredentialRawContract TestCredentialRawContractRejectsFaultyFakes
check_raw_contract ./internal/engine/readiness/disk TestCredentialRawContract

go test ./internal/engine/readiness/... ./internal/engine/session/...
