#!/usr/bin/env bash
# T-43: reads the Engine scenarios step's go test -v log once and reports every
# failure in it: first as `::error` annotations (public without a token, unlike
# the job log), then as `--- FAIL` blocks. The rule, with the log shapes it was
# written from, is T-43 in tasks/phase-1.yaml; features/README.md says what the
# output is for. Everything read comes from the checkout, so it is data: no line
# of the log is ever evaluated, and no key of an array is ever arithmetic.
#
#   engine-failure-report <log>
#
# Always exits 0 after reporting; the step that calls it runs under set +e.
set -euo pipefail
# Bytes, not characters: in a UTF-8 locale `.` and a pattern's bracket match no
# invalid byte sequence, and the steps that quote a workload's stderr with %s
# can put one on a block's first line, which would then start no block and hide
# its scenario. The cut below counts bytes too, which for ASCII is the runner's
# measure and otherwise keeps no more than it does.
export LC_ALL=C

if [[ $# != 1 ]]; then
  printf 'usage: engine-failure-report <log>\n' >&2
  exit 2
fi
log=$1

# All the runner keeps of an annotation's message (_maxIssueMessageLength). Every
# text is cut to it as it is built, so that no string here grows with the log:
# bash is quadratic when it substitutes across a long one.
limit=4096
# The runner keeps ten error annotations per step (_maxCountPerIssueType).
annotation_limit=10

titles=()
texts=()
add_failure() {
  titles+=("$1")
  texts+=("${2:0:limit}")
}

if [[ ! -f $log || ! -r $log ]]; then
  add_failure 'Engine scenarios' 'no test log: the test binary never ran'
else
  run=''           # the test the log's first === RUN line names
  current=''       # the own test the last own === RUN or === NAME line names
  in_block=0       # a go test block is being read
  block_full=0     # its text already holds the limit
  block_owner=''
  block_file=''
  block_text=''
  panic_open=0     # a panic: or fatal error: line is being read
  panic_full=0
  panic_text=''
  panics=()        # those with no own line after them so far
  scenario_names=()
  declare -A scenario_seen=()
  declare -A scenario_text=()
  run_failed=0
  run_has_text=0
  run_text=''
  last=''
  have_last=0

  # own NAME: the run's test or one of its subtests.
  is_own() {
    [[ -n $run && ( $1 == "$run" || $1 == "$run"/* ) ]]
  }
  mark_failed() {
    if [[ -z ${scenario_seen["$1"]+x} ]]; then
      scenario_seen["$1"]=1
      scenario_names+=("$1")
    fi
  }
  # An own line ends every panic: line before it, since a quoted one has its
  # own block or test line after it; only one the run died on has none.
  own_line() {
    panics=()
    panic_open=0
  }
  finish_block() {
    in_block=0
    if [[ -z $block_owner ]]; then
      return 0
    elif [[ $block_owner == "$run" ]]; then
      run_has_text=1
      run_text=$block_text
    elif [[ $block_file == suite.go ]]; then
      scenario_text["$block_owner"]=$block_text
    fi
  }

  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == *[!\ $'\t']* ]]; then
      last=$line
      have_last=1
    fi

    if ((in_block)); then
      if [[ $line == '        '* ]]; then
        if ((!block_full)); then
          block_text+=$'\n'${line:8:limit}
          if ((${#block_text} >= limit)); then block_full=1; fi
        fi
        continue
      fi
      finish_block
    fi

    if ((panic_open)); then
      if [[ $line == $'\t'* ]]; then
        if ((!panic_full)); then
          panic_text+=$'\n'${line:1:limit}
          if ((${#panic_text} >= limit)); then panic_full=1; fi
        fi
        continue
      fi
      panics+=("$panic_text")
      panic_open=0
    fi

    case $line in
      '=== RUN   '* | '=== NAME  '*)
        name=${line:10}
        if [[ -z $run && $line == '=== RUN   '* ]]; then run=$name; fi
        if is_own "$name"; then
          current=$name
          own_line
        fi
        ;;
      'panic: '* | 'fatal error: '*)
        panic_open=1
        panic_text=${line:0:limit}
        panic_full=$((${#panic_text} >= limit ? 1 : 0))
        ;;
      ' '*)
        # Cheap tests first: the regular expressions are the slow part. A block
        # start is tried before a failure line, as its first line may quote one.
        if [[ $line == '    '[!\ ]*.go:[0-9]*': '* && $line =~ ^\ {4}([^\ ]+\.go):[0-9]+:\ (.*)$ ]]; then
          # A block start is the run's own line wherever it stands.
          own_line
          in_block=1
          block_owner=$current
          block_file=${BASH_REMATCH[1]}
          block_text=${BASH_REMATCH[2]:0:limit}
          block_full=$((${#block_text} >= limit ? 1 : 0))
          if [[ -n $current && $current != "$run" && $block_file == suite.go ]]; then
            mark_failed "$current"
          fi
        elif [[ $line == *'--- FAIL: '* && $line =~ ^\ *---\ FAIL:\ (.+)\ \([0-9.]+s\)$ ]]; then
          name=${BASH_REMATCH[1]}
          if is_own "$name"; then
            own_line
            if [[ $name == "$run" ]]; then run_failed=1; else mark_failed "$name"; fi
          fi
        fi
        ;;
      '--- FAIL: '*)
        if [[ $line =~ ^---\ FAIL:\ (.+)\ \([0-9.]+s\)$ ]]; then
          name=${BASH_REMATCH[1]}
          if is_own "$name"; then
            own_line
            if [[ $name == "$run" ]]; then run_failed=1; else mark_failed "$name"; fi
          fi
        fi
        ;;
    esac
  done <"$log"
  if ((in_block)); then finish_block; fi
  if ((panic_open)); then panics+=("$panic_text"); fi

  # In this order: a timeout's list first, so that the cap never hides it; the
  # scenarios as the log first showed them fail; the run's test, only when none
  # did, as TestFeatures logs its excluded scenarios first and fails last; and a
  # log with no go test failure line at all, which a kill or a signal leaves.
  for panic_text in "${panics[@]}"; do
    add_failure 'go test' "$panic_text"
  done
  for name in "${scenario_names[@]}"; do
    if [[ -n ${scenario_text["$name"]+x} ]]; then
      add_failure "$name" "${scenario_text["$name"]}"
    else
      add_failure "$name" 'no error text in the log'
    fi
  done
  if ((${#scenario_names[@]} == 0 && run_failed)); then
    if ((run_has_text)); then
      add_failure "$run" "$run_text"
    else
      add_failure "$run" 'no error text in the log'
    fi
  fi
  if ((${#panics[@]} == 0 && !run_failed)); then
    if ((have_last)); then
      add_failure 'Engine scenarios' "the log holds no go-test failure line; its last line: $last"
    else
      add_failure 'Engine scenarios' 'the log holds no go-test failure line; it is blank'
    fi
  fi
fi

# Escapes as the runner unescapes (ActionCommand.cs; escapeData and
# escapeProperty in @actions/core): % first, then CR and LF; a title also : and ,.
annotate() {
  local title=$1 text=${2:0:limit}
  title=${title//'%'/%25}
  title=${title//$'\r'/%0D}
  title=${title//$'\n'/%0A}
  title=${title//':'/%3A}
  title=${title//','/%2C}
  text=${text//'%'/%25}
  text=${text//$'\r'/%0D}
  text=${text//$'\n'/%0A}
  printf '::error title=%s::%s\n' "$title" "$text"
}

count=${#titles[@]}
if ((count <= annotation_limit)); then
  for ((i = 0; i < count; i++)); do
    annotate "${titles[i]}" "${texts[i]}"
  done
else
  # The runner would drop everything past the tenth: the tenth names how many
  # more failed and lists them, which keeps the set comparable between re-runs.
  for ((i = 0; i < annotation_limit - 1; i++)); do
    annotate "${titles[i]}" "${texts[i]}"
  done
  rest=''
  for ((i = annotation_limit - 1; i < count && ${#rest} < limit; i++)); do
    rest+=${rest:+$'\n'}${titles[i]}
  done
  annotate "$((count - annotation_limit + 1)) more failed" "$rest"
fi

for ((i = 0; i < count; i++)); do
  printf -- '--- FAIL: %s\n' "${titles[i]}"
  while IFS= read -r text_line || [[ -n $text_line ]]; do
    printf '    %s\n' "$text_line"
  done <<<"${texts[i]}"
done
